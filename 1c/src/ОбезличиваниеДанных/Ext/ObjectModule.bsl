#КонецОбласти

#Область Проверка

Процедура ЗаписатьСнимок(Правила, Путь, Протокол)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Количество = 0;
	Для Каждого Элемент Из Правила Цикл
		Для Каждого Правило Из Элемент.Значение Цикл
			Если Правило.Класс = "идентификатор" Или Правило.Класс = "счет" Или Правило.Класс = "снилс" Тогда
				Выборка = ВыборкаЗначений("ВЫБРАТЬ РАЗЛИЧНЫЕ Т." + Правило.Реквизит + " КАК З ИЗ " + Элемент.Ключ + " КАК Т ГДЕ ПОДСТРОКА(Т." + Правило.Реквизит + ", 1, 1) <> """"");
				Если Выборка = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Пока Выборка.Следующий() Цикл
					Запись.ЗаписатьСтроку(ХешЗначения(Выборка.З));
					Количество = Количество + 1;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Запись.Закрыть();
	Протокол.Добавить("Снимок исходных значений (хеши): " + Количество);

КонецПроцедуры

Функция ВыборкаЗначений(ТекстЗапроса)

	Запрос = Новый Запрос(ТекстЗапроса);
	Попытка
		Возврат Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ХешЗначения(Значение)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ВРег(СтрЗаменить(СокрЛП(Значение), " ", "")));
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма);

КонецФункции

// Ни одно исходное значение из снимка не должно остаться в базе в правилах «идентификатор» и «счет».
Процедура Проверка(Протокол, Параметры)

	Если Параметры.Снимок = "" Или Не ФайлЕсть(Параметры.Снимок) Тогда
		Протокол.Добавить("ОТКАЗ: нет файла СНИМОК");
		Возврат;
	КонецЕсли;
	Исходные = Новый Соответствие;
	Чтение = Новый ЧтениеТекста(Параметры.Снимок, КодировкаТекста.UTF8);
	Строка = Чтение.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл
		Исходные.Вставить(Строка, Истина);
		Строка = Чтение.ПрочитатьСтроку();
	КонецЦикла;
	Чтение.Закрыть();
	Правила = ЗагрузитьПравила(Параметры.Правила);
	Осталось = 0;
	Проверено = 0;
	Для Каждого Элемент Из Правила Цикл
		Для Каждого Правило Из Элемент.Значение Цикл
			Если Правило.Класс = "идентификатор" Или Правило.Класс = "счет" Или Правило.Класс = "снилс" Тогда
				Выборка = ВыборкаЗначений("ВЫБРАТЬ РАЗЛИЧНЫЕ Т." + Правило.Реквизит + " КАК З ИЗ " + Элемент.Ключ + " КАК Т ГДЕ ПОДСТРОКА(Т." + Правило.Реквизит + ", 1, 1) <> """"");
				Если Выборка = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Пока Выборка.Следующий() Цикл
					Проверено = Проверено + 1;
					Если Исходные[ХешЗначения(Выборка.З)] <> Неопределено Тогда
						Осталось = Осталось + 1;
						Протокол.Добавить("ОСТАЛОСЬ исходное значение: " + Элемент.Ключ + "." + Правило.Реквизит);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Протокол.Добавить("Проверено значений: " + Проверено + ", исходных осталось: " + Осталось);
	ПроверитьВалидность(Протокол, Правила, Параметры.Профиль);
	НеОбезличено = ПроверитьПользователей(Протокол, Параметры);
	Осталось = Осталось + НеОбезличено;
	Протокол.Добавить(?(Осталось = 0, "РЕЗУЛЬТАТ: ОК", "РЕЗУЛЬТАТ: ПРОВАЛ"));

КонецПроцедуры

// Обратная сверка на рабочей базе (только чтение): значения из обезличенной копии (ФАЙЛ, по одному в строке) находятся
// повторным расчетом замены с тем же секретом. Отчет содержит реальные значения - он для человека, не для ИИ.
Процедура Сверка(Протокол, Параметры)

	Если СтрДлина(Параметры.Секрет) < 16 Или Параметры.Правила = "" Или Не ФайлЕсть(Параметры.Правила)
		Или Параметры.Файл = "" Или Не ФайлЕсть(Параметры.Файл) Тогда
		Протокол.Добавить("ОТКАЗ: нужны СЕКРЕТ (тот же, что при обезличивании), ПРАВИЛА и ФАЙЛ со значениями из копии");
		Возврат;
	КонецЕсли;
	Искомые = Новый Соответствие;
	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(Параметры.Файл, КодировкаТекста.UTF8);
	Для Номер = 1 По Текст.КоличествоСтрок() Цикл
		Значение = ВРег(СтрЗаменить(СокрЛП(Текст.ПолучитьСтроку(Номер)), " ", ""));
		Если Значение <> "" Тогда
			Искомые.Вставить(Значение, 0);
		КонецЕсли;
	КонецЦикла;
	Контекст = Новый Структура("Секрет, Профиль, Протокол, Занято, ТЧ, Пропущено",
		ПолучитьДвоичныеДанныеИзСтроки(Параметры.Секрет), Параметры.Профиль, Протокол, Новый Соответствие, Новый Соответствие, Новый Соответствие);
	Для Каждого Элемент Из ЗагрузитьПравила(Параметры.Правила) Цикл
		СоСсылкой = СтрНачинаетсяС(Элемент.Ключ, "Справочник.") Или СтрНачинаетсяС(Элемент.Ключ, "Документ.");
		Для Каждого Правило Из Элемент.Значение Цикл
			Если Правило.Класс <> "идентификатор" И Правило.Класс <> "счет" Тогда
				Продолжить;
			КонецЕсли;
			Выборка = ВыборкаЗначений("ВЫБРАТЬ РАЗЛИЧНЫЕ Т." + Правило.Реквизит + " КАК З"
				+ ?(СоСсылкой, ", ПРЕДСТАВЛЕНИЕ(Т.Ссылка) КАК Объект", "") + " ИЗ " + Элемент.Ключ + " КАК Т ГДЕ ПОДСТРОКА(Т." + Правило.Реквизит + ", 1, 1) <> """"");
			Если Выборка = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Пока Выборка.Следующий() Цикл
				Синтетическое = ?(Правило.Класс = "счет", СинтетическийСчет(Контекст, Выборка.З), СинтетическийИдентификатор(Контекст, Выборка.З));
				Ключ = ВРег(СтрЗаменить(Синтетическое, " ", ""));
				Если Искомые[Ключ] <> Неопределено Тогда
					Искомые.Вставить(Ключ, Искомые[Ключ] + 1);
					Протокол.Добавить(Синтетическое + " -> " + Выборка.З + " | " + Элемент.Ключ + "." + Правило.Реквизит
						+ ?(СоСсылкой, " | " + Выборка.Объект, ""));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Найдено = 0;
	Для Каждого Пара Из Искомые Цикл
		Если Пара.Значение > 0 Тогда
			Найдено = Найдено + 1;
		Иначе
			Протокол.Добавить("НЕ НАЙДЕНО: " + Пара.Ключ);
		КонецЕсли;
	КонецЦикла;
	Протокол.Добавить("Сверка: найдено " + Найдено + " из " + Искомые.Количество());

КонецПроцедуры

// Пользователи, которые не обезличены и не оставлены намеренно (текущий и ОСТАВИТЬ).
Функция ПроверитьПользователей(Протокол, Параметры)

	Оставить = ОставляемыеПользователи(Параметры);
	Обезличено = 0;
	Оставлено = 0;
	Осталось = 0;
	Для Каждого Пользователь Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Если Оставить[НРег(Пользователь.Имя)] <> Неопределено Тогда
			Оставлено = Оставлено + 1;
		ИначеЕсли Лев(Пользователь.Имя, 4) = "user" И Лев(Пользователь.ПолноеИмя, 13) = "Пользователь " Тогда
			Обезличено = Обезличено + 1;
		Иначе
			Осталось = Осталось + 1;
		КонецЕсли;
	КонецЦикла;
	Протокол.Добавить("Пользователи информационной базы: обезличено " + Обезличено + ", оставлено намеренно " + Оставлено + ", не обезличено " + Осталось);
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Наименование КАК Имя, Т.ИдентификаторПользователяИБ КАК Идентификатор ИЗ Справочник.Пользователи КАК Т ГДЕ НЕ Т.Предопределенный");
	ОставленныеИдентификаторы = Новый Соответствие;
	Для Каждого Пользователь Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Если Оставить[НРег(Пользователь.Имя)] <> Неопределено Тогда
			ОставленныеИдентификаторы.Вставить(Пользователь.УникальныйИдентификатор, Истина);
		КонецЕсли;
	КонецЦикла;
	Выборка = Запрос.Выполнить().Выбрать();
	ЭлементовОбезличено = 0;
	ЭлементовОставлено = 0;
	ЭлементовОсталось = 0;
	Пока Выборка.Следующий() Цикл
		Если ОставленныеИдентификаторы[Выборка.Идентификатор] <> Неопределено Тогда
			ЭлементовОставлено = ЭлементовОставлено + 1;
		ИначеЕсли Лев(Выборка.Имя, 13) = "Пользователь " И СтрДлина(Выборка.Имя) = 19 Тогда
			ЭлементовОбезличено = ЭлементовОбезличено + 1;
		Иначе
			ЭлементовОсталось = ЭлементовОсталось + 1;
		КонецЕсли;
	КонецЦикла;
	Протокол.Добавить("Элементы справочника «Пользователи»: обезличено " + ЭлементовОбезличено + ", оставлено " + ЭлементовОставлено + ", не обезличено " + ЭлементовОсталось);
	Возврат Осталось + ЭлементовОсталось;

КонецФункции

// Каждое 12-значное значение идентификатора должно иметь верную контрольную цифру, каждый IBAN KZ - верный остаток 97.
Процедура ПроверитьВалидность(Протокол, Правила, Профиль)

	ВсегоИИН = 0;
	НевернихИИН = 0;
	ВсегоIBAN = 0;
	НевернихIBAN = 0;
	Для Каждого Элемент Из Правила Цикл
		Для Каждого Правило Из Элемент.Значение Цикл
			Если Правило.Класс <> "идентификатор" И Правило.Класс <> "счет" И Правило.Класс <> "снилс" Тогда
				Продолжить;
			КонецЕсли;
			Выборка = ВыборкаЗначений("ВЫБРАТЬ РАЗЛИЧНЫЕ Т." + Правило.Реквизит + " КАК З ИЗ " + Элемент.Ключ + " КАК Т ГДЕ ПОДСТРОКА(Т." + Правило.Реквизит + ", 1, 1) <> """"");
			Если Выборка = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Пока Выборка.Следующий() Цикл
				Значение = ВРег(СтрЗаменить(СокрЛП(Выборка.З), " ", ""));
				Если Профиль = "KZ" И Правило.Класс = "идентификатор" И СтрДлина(ТолькоЦифры(Значение)) = СтрДлина(Значение) И СтрДлина(Значение) >= 11 И СтрДлина(Значение) <= 13 Тогда
					ВсегоИИН = ВсегоИИН + 1;
					Если СтрДлина(Значение) <> 12 Или КонтрольныйРазряд(Лев(Значение, 11)) <> Число(Прав(Значение, 1)) Тогда
						НевернихИИН = НевернихИИН + 1;
						Протокол.Добавить("Неверный идентификатор: " + Элемент.Ключ + "." + Правило.Реквизит + ", длина " + СтрДлина(Значение));
					КонецЕсли;
				ИначеЕсли Профиль = "RU" И Правило.Класс = "идентификатор" И (СтрДлина(Значение) = 10 Или СтрДлина(Значение) = 12) И СтрДлина(ТолькоЦифры(Значение)) = СтрДлина(Значение) Тогда
					ВсегоИИН = ВсегоИИН + 1;
					Если Не ИННВерный(Значение) Тогда
						НевернихИИН = НевернихИИН + 1;
					КонецЕсли;
				ИначеЕсли Правило.Класс = "снилс" И СтрДлина(ТолькоЦифры(Значение)) = 11 Тогда
					ВсегоИИН = ВсегоИИН + 1;
					Цифровое = ТолькоЦифры(Значение);
					Если КонтрольСНИЛС(Лев(Цифровое, 9)) <> Число(Прав(Цифровое, 2)) Тогда
						НевернихИИН = НевернихИИН + 1;
					КонецЕсли;
				ИначеЕсли Правило.Класс = "счет" И Лев(Значение, 2) = "KZ" Тогда
					ВсегоIBAN = ВсегоIBAN + 1;
					Если СтрДлина(Значение) <> 20 Или ОстатокIBAN(Сред(Значение, 5) + Лев(Значение, 4)) <> 1 Тогда
						НевернихIBAN = НевернихIBAN + 1;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Протокол.Добавить("12-значных идентификаторов: " + ВсегоИИН + ", с неверной контрольной цифрой: " + НевернихИИН);
	Протокол.Добавить("IBAN KZ: " + ВсегоIBAN + ", с неверным контролем: " + НевернихIBAN);

КонецПроцедуры

#КонецОбласти

#Область Самопроверка

// Выводит образцы работы генераторов: быстро показывает, что платформа ведет себя как ожидается (нули, форматы, контроль).
Процедура Самопроверка(Протокол)

	Контекст = Новый Структура("Секрет, Профиль, Протокол, Занято, ТЧ, Пропущено",
		ПолучитьДвоичныеДанныеИзСтроки("самопроверка-секрет-0123456789"), "RU", Протокол, Новый Соответствие, Новый Соответствие, Новый Соответствие);
	Протокол.Добавить("Формат(0, ЧГ=0) = [" + Формат(0, "ЧГ=0") + "]");
	Протокол.Добавить("Формат(7, ЧГ=0) = [" + Формат(7, "ЧГ=0") + "]");
	Протокол.Добавить("Нули(5, 3) = [" + Нули(5, 3) + "]");
	Протокол.Добавить("Нули(0, 2) = [" + Нули(0, 2) + "]");
	Для Номер = 1 По 6 Цикл
		Цифры_ = Цифры(Контекст, "проба" + Номер, 8);
		Протокол.Добавить("Цифры(8) " + Номер + " = [" + Цифры_ + "] длина " + СтрДлина(Цифры_));
	КонецЦикла;
	Протокол.Добавить("СНИЛС образец: " + СинтетическийСНИЛС(Контекст, "112-233-445 95"));
	Протокол.Добавить("КонтрольСНИЛС(112233445) = " + КонтрольСНИЛС("112233445") + " (ожидается 95)");
	Протокол.Добавить("ИНН10: " + СинтетическийИНН(Контекст, "7707083893") + ", ИНН12: " + СинтетическийИНН(Контекст, "500100732259"));
	Протокол.Добавить("ИННВерный(7707083893) = " + ИННВерный("7707083893"));
	Контекст.Профиль = "KZ";
	Протокол.Добавить("ИИН/БИН KZ: " + СинтетическийИИНБИН(Контекст, "900412300123") + ", " + СинтетическийИИНБИН(Контекст, "150340000385"));
	Протокол.Добавить("IBAN: " + СинтетическийСчет(Контекст, "KZ86125KZT5004100100"));
	МассоваяПроверка(Протокол, Контекст);
	Протокол.Добавить("ПсевдоФормат: " + ПсевдоФормат(Контекст, "ф", "АА9АА9-ab 12"));

КонецПроцедуры

#КонецОбласти

#Область МассоваяПроверкаГенераторов

// Тысяча значений каждого генератора: длина и контрольные цифры. Нули в начале и в конце не должны теряться.
Процедура МассоваяПроверка(Протокол, Контекст)

	Результат = Новый Структура("ИИН, БИН, ИНН10, ИНН12, СНИЛС, IBAN", 0, 0, 0, 0, 0, 0);
	Контекст.Профиль = "KZ";
	Для Номер = 1 По 1000 Цикл
		Исходный = Цифры(Контекст, "тест-иин" + Номер, 12);
		Значение = СинтетическийИИНБИН(Контекст, "900412" + "3" + Прав(Исходный, 5));
		Если СтрДлина(Значение) <> 12 Или КонтрольныйРазряд(Лев(Значение, 11)) <> Число(Прав(Значение, 1)) Тогда
			Результат.ИИН = Результат.ИИН + 1;
		КонецЕсли;
		Значение = СинтетическийИИНБИН(Контекст, "15034" + "0" + "000" + Прав(Исходный, 3));
		Если СтрДлина(Значение) <> 12 Или КонтрольныйРазряд(Лев(Значение, 11)) <> Число(Прав(Значение, 1)) Тогда
			Результат.БИН = Результат.БИН + 1;
		КонецЕсли;
		Значение = СинтетическийСчет(Контекст, "KZ86125KZT50041" + Прав(Исходный, 5));
		Если СтрДлина(Значение) <> 20 Или ОстатокIBAN(Сред(Значение, 5) + Лев(Значение, 4)) <> 1 Тогда
			Результат.IBAN = Результат.IBAN + 1;
		КонецЕсли;
	КонецЦикла;
	Контекст.Профиль = "RU";
	Для Номер = 1 По 1000 Цикл
		Исходный = Цифры(Контекст, "тест-инн" + Номер, 12);
		Значение = СинтетическийИНН(Контекст, Лев(Исходный, 10));
		Если СтрДлина(Значение) <> 10 Или Не ИННВерный(Значение) Тогда
			Результат.ИНН10 = Результат.ИНН10 + 1;
		КонецЕсли;
		Значение = СинтетическийИНН(Контекст, Исходный);
		Если СтрДлина(Значение) <> 12 Или Не ИННВерный(Значение) Тогда
			Результат.ИНН12 = Результат.ИНН12 + 1;
		КонецЕсли;
		Значение = СинтетическийСНИЛС(Контекст, "112-233-445 95" + Номер);
		Цифровое = ТолькоЦифры(СинтетическийСНИЛС(Контекст, "112-233-" + Нули(Номер, 3) + " 00"));
		Если СтрДлина(Цифровое) <> 11 Или КонтрольСНИЛС(Лев(Цифровое, 9)) <> Число(Прав(Цифровое, 2)) Тогда
			Результат.СНИЛС = Результат.СНИЛС + 1;
		КонецЕсли;
	КонецЦикла;
	Протокол.Добавить("Массовая проверка (из 1000, неверных): ИИН " + Результат.ИИН + ", БИН " + Результат.БИН + ", IBAN " + Результат.IBAN
		+ ", ИНН10 " + Результат.ИНН10 + ", ИНН12 " + Результат.ИНН12 + ", СНИЛС " + Результат.СНИЛС);

КонецПроцедуры

#КонецОбласти

#Область Остатки

// Поиск остатков по ВСЕМ строковым реквизитам и табличным частям: что осталось похожим на ИИН/БИН, IBAN KZ, e-mail.
Процедура Остатки(Протокол, Параметры)

	Покрыто = Новый Соответствие;
	Если Параметры.Правила <> "" И ФайлЕсть(Параметры.Правила) Тогда
		Для Каждого Элемент Из ЗагрузитьПравила(Параметры.Правила) Цикл
			Для Каждого Правило Из Элемент.Значение Цикл
				Покрыто.Вставить(Элемент.Ключ + "." + Правило.Реквизит, Истина);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	ПокрытыеПоля = Покрыто;

	Протокол.Добавить("");
	Протокол.Добавить("== Остатки (объект.реквизит | ИИН-подобных | IBAN KZ | e-mail | образец маски)");
	Пропуск = ",ИдентификаторыОбъектовМетаданных,ИдентификаторыОбъектовРасширений,";
	Для Каждого Вид Из СтрРазделить("Справочник,Документ,РегистрСведений", ",") Цикл
		Если Вид = "Справочник" Тогда
			Коллекция = Метаданные.Справочники;
		ИначеЕсли Вид = "Документ" Тогда
			Коллекция = Метаданные.Документы;
		Иначе
			Коллекция = Метаданные.РегистрыСведений;
		КонецЕсли;
		Номер = 0;
		Для Каждого Объект Из Коллекция Цикл
			Номер = Номер + 1;
			Если СтрНайти(Пропуск, "," + Объект.Имя + ",") = 0 Тогда
				ОстаткиВОбъекте(Протокол, Вид + "." + Объект.Имя, Объект, Вид);
			КонецЕсли;
			Если Номер % 20 = 0 Тогда
				Протокол.Добавить("... " + Вид + ": просмотрено " + Номер);
				Сохранить();
			КонецЕсли;
		КонецЦикла;
		Сохранить();
	КонецЦикла;

КонецПроцедуры

Процедура ОстаткиВОбъекте(Протокол, ПолноеИмя, Объект, Вид)

	ОстаткиВНаборе(Протокол, ПолноеИмя, ПолноеИмя, СтрокиОбъекта(Объект, Вид));
	Если Вид <> "РегистрСведений" Тогда
		Для Каждого ТЧ Из Объект.ТабличныеЧасти Цикл
			Имена = Новый Массив;
			Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
				Если ЭтоСтрока(Реквизит) Тогда
					Имена.Добавить(Реквизит.Имя);
				КонецЕсли;
			КонецЦикла;
			ОстаткиВНаборе(Протокол, ПолноеИмя + "." + ТЧ.Имя, ПолноеИмя + "." + ТЧ.Имя, Имена);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция СтрокиОбъекта(Объект, Вид)

	Имена = Новый Массив;
	Для Каждого Реквизит Из Объект.Реквизиты Цикл
		Если ЭтоСтрока(Реквизит) Тогда
			Имена.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	Если Вид = "РегистрСведений" Тогда
		Для Каждого Реквизит Из Объект.Измерения Цикл
			Если ЭтоСтрока(Реквизит) Тогда
				Имена.Добавить(Реквизит.Имя);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Реквизит Из Объект.Ресурсы Цикл
			Если ЭтоСтрока(Реквизит) Тогда
				Имена.Добавить(Реквизит.Имя);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Вид = "Справочник" И Объект.ДлинаНаименования > 0 Тогда
		Имена.Добавить("Наименование");
	КонецЕсли;
	Возврат Имена;

КонецФункции

Функция Повтор(Строка_, Раз)

	Результат = "";
	Для Индекс = 1 По Раз Цикл
		Результат = Результат + Строка_;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ОстаткиВНаборе(Протокол, Метка, Источник, Имена)

	Цифры12 = "%" + Повтор("[0-9]", 12) + "%";
	ИбанKZ = "%KZ" + Повтор("[0-9A-Z]", 18) + "%";
	Для Каждого Имя Из Имена Цикл
		Если ПокрытыеПоля <> Неопределено И ПокрытыеПоля[Метка + "." + Имя] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Поле = "ПОДСТРОКА(Т." + Имя + ", 1, 400)";
		Текст = "ВЫБРАТЬ
			|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА " + Поле + " ПОДОБНО """ + Цифры12 + """ ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК ИИН,
			|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА " + Поле + " ПОДОБНО """ + ИбанKZ + """ ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК IBAN,
			|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА " + Поле + " ПОДОБНО ""%@%.%"" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК Почта
			|ИЗ " + Источник + " КАК Т";
		Запрос = Новый Запрос(Текст);
		Попытка
			Строка = Запрос.Выполнить().Выгрузить()[0];
		Исключение
			Продолжить;
		КонецПопытки;
		Если Строка.ИИН + Строка.IBAN + Строка.Почта > 0 Тогда
			Образец = "";
			ЗапросОбразца = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 " + Поле + " КАК З ИЗ " + Источник + " КАК Т ГДЕ " + Поле + " ПОДОБНО """ + Цифры12 + """ ИЛИ " + Поле + " ПОДОБНО """ + ИбанKZ + """ ИЛИ " + Поле + " ПОДОБНО ""%@%.%""");
			Выборка = ЗапросОбразца.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Образец = Маска(Выборка.З);
			КонецЕсли;
			Протокол.Добавить(Метка + "." + Имя + " | " + Строка.ИИН + " | " + Строка.IBAN + " | " + Строка.Почта + " | " + Образец);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Инвентаризация

// Класс по имени реквизита: по точному имени, затем по фрагменту. Пустая строка - не чувствительный.
Функция КлассПоИмени(Имя)

	Точные = Новый Соответствие;
	Для Каждого Имя_ Из СтрРазделить("ИДЕНТИФИКАЦИОННЫЙКОДЛИЧНОСТИ,ИДЕНТИФИКАЦИОННЫЙНОМЕР,ИИН,БИН,ИНН,КПП,РНН,СИК,ОГРН,СНИЛС,ИННФИЗЛИЦА,ИИНБИН", ",") Цикл
		Точные.Вставить(Имя_, "идентификатор");
	КонецЦикла;
	Для Каждого Имя_ Из СтрРазделить("НОМЕРСЧЕТА,IBAN,РАСЧЕТНЫЙСЧЕТ,НОМЕРКАРТЫ", ",") Цикл
		Точные.Вставить(Имя_, "счет");
	КонецЦикла;
	Для Каждого Имя_ Из СтрРазделить("ФАМИЛИЯ,ИМЯ,ОТЧЕСТВО,ФИО,НАИМЕНОВАНИЕПОЛНОЕ,ПРЕДСТАВЛЕНИЕ", ",") Цикл
		Точные.Вставить(Имя_, "имя");
	КонецЦикла;
	Для Каждого Имя_ Из СтрРазделить("КОММЕНТАРИЙ,ОПИСАНИЕ,ПРИМЕЧАНИЕ,ТЕКСТКОРРЕСПОНДЕНТА,ТЕКСТНАЗНАЧЕНИЯ,НАЗНАЧЕНИЕПЛАТЕЖА,СОДЕРЖАНИЕ", ",") Цикл
		Точные.Вставить(Имя_, "свободный текст");
	КонецЦикла;

	Верхний = ВРег(Имя);
	Класс = Точные[Верхний];
	Если Класс <> Неопределено Тогда
		Возврат Класс;
	КонецЕсли;
	Фрагменты = Новый Массив;
	Фрагменты.Добавить("ТЕЛЕФОН|телефон");
	Фрагменты.Добавить("ПОЧТ|почта");
	Фрагменты.Добавить("EMAIL|почта");
	Фрагменты.Добавить("АДРЕС|адрес");
	Фрагменты.Добавить("ПАСПОРТ|документ личности");
	Фрагменты.Добавить("УДОСТОВЕР|документ личности");
	Фрагменты.Добавить("ЛОГИН|учетные данные");
	Фрагменты.Добавить("ПАРОЛЬ|учетные данные");
	Фрагменты.Добавить("ТОКЕН|учетные данные");
	Фрагменты.Добавить("ФИЗЛИЦ|ссылка на физлицо");
	Фрагменты.Добавить("СТРАХОВОЙНОМЕР|идентификатор");
	Фрагменты.Добавить("ЛИЦЕВОЙ|счет");
	Фрагменты.Добавить("ИМЯФАЙЛА|имя файла");
	Фрагменты.Добавить("РЕКВИЗИТЫКОНТРАГЕНТА|имя");
	Для Каждого Пара Из Фрагменты Цикл
		Части = СтрРазделить(Пара, "|");
		Если СтрНайти(Верхний, Части[0]) > 0 Тогда
			Возврат Части[1];
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Маска значения без раскрытия: цифры 9, буквы А/а, прочее как есть, не длиннее 24 знаков.
Функция Маска(Значение)

	Результат = "";
	Строка = Лев(СокрЛП(Значение), 24);
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Результат = Результат + "9";
		ИначеЕсли Символ <> НРег(Символ) Тогда
			Результат = Результат + "А";
		ИначеЕсли Символ <> ВРег(Символ) Тогда
			Результат = Результат + "а";
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЭтоСтрока(Реквизит)
	Возврат Реквизит.Тип.СодержитТип(Тип("Строка"));
КонецФункции

Процедура Инвентаризация(Протокол)

	Протокол.Добавить("");
	Протокол.Добавить("== Расширения");
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Протокол.Добавить(Расширение.Имя + " активно=" + Расширение.Активно);
	КонецЦикла;

	Протокол.Добавить("");
	Протокол.Добавить("== Регламентные задания (включенные)");
	Для Каждого Задание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания() Цикл
		Если Задание.Использование Тогда
			Протокол.Добавить(Задание.Метаданные.Имя);
		КонецЕсли;
	КонецЦикла;

	Протокол.Добавить("");
	Протокол.Добавить("== Чувствительные реквизиты: объект.реквизит | класс | всего записей | заполнено | образец (маска)");
	Для Каждого Вид Из СтрРазделить("Справочник,Документ,РегистрСведений", ",") Цикл
		Если Вид = "Справочник" Тогда
			Коллекция = Метаданные.Справочники;
		ИначеЕсли Вид = "Документ" Тогда
			Коллекция = Метаданные.Документы;
		Иначе
			Коллекция = Метаданные.РегистрыСведений;
		КонецЕсли;
		Номер = 0;
		Для Каждого Объект Из Коллекция Цикл
			ИнвентаризацияОбъекта(Протокол, Вид, Объект);
			Номер = Номер + 1;
			Если Номер % 20 = 0 Тогда
				Протокол.Добавить("... " + Вид + ": просмотрено " + Номер);
				Сохранить();
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Протокол.Добавить("");
	Протокол.Добавить("== Присоединенные файлы (справочники *ПрисоединенныеФайлы)");
	Для Каждого Объект Из Метаданные.Справочники Цикл
		Если СтрЗаканчиваетсяНа(Объект.Имя, "ПрисоединенныеФайлы") Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Справочник." + Объект.Имя);
			Количество = Запрос.Выполнить().Выгрузить()[0].К;
			Если Количество > 0 Тогда
				Протокол.Добавить(Объект.Имя + ": " + Количество);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ИнвентаризацияОбъекта(Протокол, Вид, Объект)

	Имена = Новый Массив;
	Для Каждого Реквизит Из Объект.Реквизиты Цикл
		Имена.Добавить(Реквизит);
	КонецЦикла;
	Если Вид = "РегистрСведений" Тогда
		Для Каждого Реквизит Из Объект.Измерения Цикл
			Имена.Добавить(Реквизит);
		КонецЦикла;
		Для Каждого Реквизит Из Объект.Ресурсы Цикл
			Имена.Добавить(Реквизит);
		КонецЦикла;
	КонецЕсли;
	Если Вид = "Справочник" Тогда
		Если Объект.ДлинаНаименования > 0 И ИменаЛиц(Объект.Имя) Тогда
			Имена.Добавить(Новый Структура("Имя, Тип", "Наименование", Новый ОписаниеТипов("Строка")));
		КонецЕсли;
	КонецЕсли;

	ИнвентаризацияСписка(Протокол, Вид + "." + Объект.Имя, Имена);

	Если Вид <> "РегистрСведений" Тогда
		ИнвентаризацияТабличныхЧастей(Протокол, Вид, Объект);
	КонецЕсли;

	Если Вид = "Справочник" Тогда
		Для Каждого ТЧ Из Объект.ТабличныеЧасти Цикл
			Если ТЧ.Имя = "КонтактнаяИнформация" Тогда
				Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Справочник." + Объект.Имя + ".КонтактнаяИнформация КАК Т");
				Количество = Запрос.Выполнить().Выгрузить()[0].К;
				Если Количество > 0 Тогда
					Протокол.Добавить("Справочник." + Объект.Имя + ".КонтактнаяИнформация (табличная часть) | контакты | " + Количество);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ИнвентаризацияСписка(Протокол, ПолноеИмя, Имена)

	Для Каждого Реквизит Из Имена Цикл
		Если Не ЭтоСтрока(Реквизит) Тогда
			Продолжить;
		КонецЕсли;
		Класс = КлассПоИмени(Реквизит.Имя);
		Если Класс = "" И Реквизит.Имя = "Наименование" Тогда
			Класс = "имя";
		КонецЕсли;
		Если Класс = "" Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос(
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего, ЕСТЬNULL(СУММА(ВЫБОР КОГДА ПОДСТРОКА(Т." + Реквизит.Имя + ", 1, 1) <> """" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК Заполнено ИЗ "
			+ ПолноеИмя + " КАК Т");
		Попытка
			Строка = Запрос.Выполнить().Выгрузить()[0];
		Исключение
			Протокол.Добавить(ПолноеИмя + "." + Реквизит.Имя + " | " + Класс + " | запрос не выполнен");
			Продолжить;
		КонецПопытки;
		Если Строка.Заполнено = 0 Тогда
			Продолжить;
		КонецЕсли;
		Образец = "";
		ЗапросОбразца = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 ПОДСТРОКА(Т." + Реквизит.Имя + ", 1, 24) КАК Значение ИЗ " + ПолноеИмя + " КАК Т ГДЕ ПОДСТРОКА(Т." + Реквизит.Имя + ", 1, 1) <> """"");
		Выборка = ЗапросОбразца.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Образец = Маска(Выборка.Значение);
		КонецЕсли;
		Протокол.Добавить(ПолноеИмя + "." + Реквизит.Имя + " | " + Класс + " | " + Строка.Всего + " | " + Строка.Заполнено + " | " + Образец);
	КонецЦикла;

КонецПроцедуры

// Строковые реквизиты табличных частей по тем же признакам имени (ФИО, ИНН, счета, телефоны, адреса, комментарии).
Процедура ИнвентаризацияТабличныхЧастей(Протокол, Вид, Объект)

	Для Каждого ТЧ Из Объект.ТабличныеЧасти Цикл
		Имена = Новый Массив;
		Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
			Если ЭтоСтрока(Реквизит) Тогда
				Имена.Добавить(Реквизит);
			КонецЕсли;
		КонецЦикла;
		Если Имена.Количество() > 0 Тогда
			ИнвентаризацияСписка(Протокол, Вид + "." + Объект.Имя + "." + ТЧ.Имя, Имена);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Наименование считаем чувствительным у справочников контрагентов и лиц.
Функция ИменаЛиц(ИмяСправочника)

	Для Каждого Часть Из СтрРазделить("Контрагент,ФизическиеЛица,Организации,Сотрудники,КонтактныеЛица,Физлиц", ",") Цикл
		Если СтрНайти(ИмяСправочника, Часть) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти
