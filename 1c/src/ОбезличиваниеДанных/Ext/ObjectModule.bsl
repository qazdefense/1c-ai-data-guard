// Часть ФИО: 1 - фамилия, 2 - имя, 3 - отчество. Женские формы: Алиев - Алиева, Серик - Сериковна.
Функция ЧастьФИО(Контекст, Зерно, Номер)

	Списки = Списки();
	Префикс = ?(Контекст.Профиль = "RU", "РУ", "КЗ");
	Женщина = ПолЛица(Контекст, Зерно);
	Если Номер = 1 Тогда
		Фамилия = Часть(Контекст, Зерно, "фам", Списки[Префикс + "Фамилии"]);
		Возврат ?(Женщина И (СтрЗаканчиваетсяНа(Фамилия, "ов") Или СтрЗаканчиваетсяНа(Фамилия, "ев") Или СтрЗаканчиваетсяНа(Фамилия, "ин")), Фамилия + "а", Фамилия);
	ИначеЕсли Номер = 2 Тогда
		Возврат Часть(Контекст, Зерно, "имя", Списки[Префикс + ?(Женщина, "Имена_ж", "Имена_м")]);
	КонецЕсли;
	Отец = Часть(Контекст, Зерно, "отец", Списки[Префикс + "Отцы"]);
	Возврат Отец + ?(Женщина, "овна", "ович");

КонецФункции

Функция ФИОПолностью(Контекст, Зерно)

	Возврат ЧастьФИО(Контекст, Зерно, 1) + " " + ЧастьФИО(Контекст, Зерно, 2) + " " + ЧастьФИО(Контекст, Зерно, 3);

КонецФункции

// Организация сохраняет форму (ТОО, АО, ИП, ООО...), название заменяется. Физическое лицо получает ФИО.
Функция НаименованиеКонтрагента(Контекст, Старое, Зерно, Полное)

	Если Не ЗначениеЗаполнено(Старое) Тогда
		Возврат Старое;
	КонецЕсли;
	Формы = Новый Массив;
	Формы.Добавить("ТОВАРИЩЕСТВО С ОГРАНИЧЕННОЙ ОТВЕТСТВЕННОСТЬЮ|ТОО|Товарищество с ограниченной ответственностью");
	Формы.Добавить("ОБЩЕСТВО С ОГРАНИЧЕННОЙ ОТВЕТСТВЕННОСТЬЮ|ООО|Общество с ограниченной ответственностью");
	Формы.Добавить("АКЦИОНЕРНОЕ ОБЩЕСТВО|АО|Акционерное общество");
	Формы.Добавить("ИНДИВИДУАЛЬНЫЙ ПРЕДПРИНИМАТЕЛЬ|ИП|Индивидуальный предприниматель");
	Формы.Добавить("ТОО|ТОО|Товарищество с ограниченной ответственностью");
	Формы.Добавить("ООО|ООО|Общество с ограниченной ответственностью");
	Формы.Добавить("АО|АО|Акционерное общество");
	Формы.Добавить("ИП|ИП|Индивидуальный предприниматель");
	Формы.Добавить("ЗАО|ЗАО|Закрытое акционерное общество");
	Формы.Добавить("ГККП|ГККП|ГККП");
	Формы.Добавить("РГП|РГП|РГП");
	Формы.Добавить("КХ|КХ|Крестьянское хозяйство");
	Формы.Добавить("ПК|ПК|Производственный кооператив");
	Верх = ВРег(СокрЛП(Старое));
	Для Каждого Форма Из Формы Цикл
		Части = СтрРазделить(Форма, "|");
		Если Верх = Части[0] Или Лев(Верх, СтрДлина(Части[0]) + 1) = Части[0] + " " Или Лев(Верх, СтрДлина(Части[0]) + 1) = Части[0] + """" Тогда
			Название = ?(Части[1] = "ИП", ФИОПолностью(Контекст, Зерно), """Тест-" + Цифры(Контекст, "орг" + Зерно, 6) + """");
			Возврат ?(Полное, Части[2], Части[1]) + " " + Название;
		КонецЕсли;
	КонецЦикла;
	Возврат ФИОПолностью(Контекст, Зерно);

КонецФункции

// Номер и дата договора остаются, название контрагента из наименования уходит.
Функция НаименованиеДоговора(Старое, Запись)

	Если Не ЗначениеЗаполнено(Старое) Тогда
		Возврат Старое;
	КонецЕсли;
	Номер = "";
	ДатаДоговора = Неопределено;
	Для Каждого Имя Из СтрРазделить("НомерДоговора,Номер", ",") Цикл
		Попытка
			Номер = СокрЛП(Запись[Имя]);
			Прервать;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ДатаДоговора,Дата", ",") Цикл
		Попытка
			ДатаДоговора = Запись[Имя];
			Прервать;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат "Договор № " + ?(Номер = "", "б/н", Номер) + ?(ЗначениеЗаполнено(ДатаДоговора), " от " + Формат(ДатаДоговора, "ДЛФ=D"), "");

КонецФункции

// Значение контактной информации по ее типу: телефон, почта, адрес, прочее.
Функция ЗначениеКонтакта(Контекст, Старое, Зерно, Запись)

	Если Не ЗначениеЗаполнено(Старое) Тогда
		Возврат Старое;
	КонецЕсли;
	Тип_ = "";
	Попытка
		Тип_ = ВРег(Строка(Запись.Тип));
	Исключение
	КонецПопытки;
	Если СтрНайти(Тип_, "ТЕЛЕФОН") > 0 Или СтрНайти(Тип_, "ФАКС") > 0 Тогда
		Возврат "+7 700 000 " + Цифры(Контекст, "тел" + Зерно + Старое, 2) + " " + Цифры(Контекст, "тел2" + Зерно + Старое, 2);
	ИначеЕсли СтрНайти(Тип_, "ПОЧТ") > 0 Тогда
		Возврат "user" + Цифры(Контекст, "почта" + Зерно + Старое, 8) + "@test.invalid";
	ИначеЕсли СтрНайти(Тип_, "АДРЕС") > 0 Тогда
		Возврат "Тестовый адрес, дом " + Формат(Число_(Контекст, "адрес", Зерно + Старое, 0, 98) + 1, "ЧГ=0");
	КонецЕсли;
	Возврат "Контакт обезличен";

